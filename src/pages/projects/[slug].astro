---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projects, profile } from "../../data/profile";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const otherProjects = projects.filter((p) => p.slug !== project.slug).slice(0, 2);

const meta = [
  { label: "Klien", value: project.client },
  { label: "Peran", value: project.role },
  { label: "Periode", value: project.period },
  { label: "Kategori", value: project.category },
];
---

<Layout title={`${project.title} — ${profile.name}`} description={project.description}>
  <Header />

  <main>
    <section class="relative isolate overflow-hidden border-b border-slate-200 dark:border-white/10">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
        <div
          class="absolute top-[-12rem] left-1/2 h-[28rem] w-[56rem] -translate-x-1/2 rounded-full bg-linear-to-br from-indigo-200/60 via-violet-200/30 to-transparent blur-3xl dark:from-indigo-500/15 dark:via-violet-500/10"
        >
        </div>
      </div>

      <div class="mx-auto max-w-5xl px-6 pt-10 pb-12 sm:pt-14 sm:pb-16">
        <a
          href="/#projects"
          class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 transition hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-400"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M11 18l-6-6 6-6" />
          </svg>
          Semua proyek
        </a>

        <span
          class="mt-8 block w-fit rounded-md bg-indigo-50 px-2 py-1 text-xs font-semibold text-indigo-700 dark:bg-indigo-500/15 dark:text-indigo-300"
        >
          {project.category}
        </span>
        <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-balance text-slate-900 sm:text-5xl dark:text-white">
          {project.title}
        </h1>
        <p class="mt-2 text-lg font-medium text-slate-500 dark:text-slate-400">{project.client}</p>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty">{project.description}</p>
      </div>
    </section>

    <section class="py-14 sm:py-20">
      <div class="mx-auto grid max-w-5xl gap-12 px-6 lg:grid-cols-3">
        <div class="space-y-12 lg:col-span-2">
          <div>
            <h2 class="text-xl font-bold text-slate-900 dark:text-white">Tentang proyek</h2>
            <div class="mt-4 space-y-4 leading-relaxed text-pretty">
              {project.details.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </div>

          <div>
            <h2 class="text-xl font-bold text-slate-900 dark:text-white">Kontribusi saya</h2>
            <ul class="mt-4 space-y-2.5">
              {
                project.highlights.map((point) => (
                  <li class="flex gap-3 leading-relaxed">
                    <svg class="mt-1.5 size-4 shrink-0 text-indigo-600 dark:text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12l5 5L20 7" />
                    </svg>
                    <span>{point}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          {
            project.screenshots.length > 0 && (
              <div>
                <h2 class="text-xl font-bold text-slate-900 dark:text-white">Screenshot</h2>
                <div class="mt-4 grid gap-4 sm:grid-cols-2">
                  {project.screenshots.map((shot) => (
                    <figure class="overflow-hidden rounded-xl border border-slate-200 bg-slate-50 dark:border-white/10 dark:bg-white/5">
                      <img src={shot.src} alt={shot.alt} loading="lazy" class="h-auto w-full" />
                    </figure>
                  ))}
                </div>
              </div>
            )
          }
        </div>

        <aside class="lg:col-span-1">
          <div
            class="sticky top-24 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/[0.03] dark:shadow-none"
          >
            <dl class="space-y-4">
              {
                meta.map((item) => (
                  <div>
                    <dt class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">
                      {item.label}
                    </dt>
                    <dd class="mt-1 text-sm font-medium text-slate-900 dark:text-white">{item.value}</dd>
                  </div>
                ))
              }
              <div>
                <dt class="text-xs font-semibold tracking-wide text-slate-500 uppercase dark:text-slate-400">
                  Tech stack
                </dt>
                <dd class="mt-2 flex flex-wrap gap-1.5">
                  {
                    project.tags.map((tag) => (
                      <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600 dark:bg-white/10 dark:text-slate-300">
                        {tag}
                      </span>
                    ))
                  }
                </dd>
              </div>
            </dl>

            {
              project.link && (
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 active:scale-[0.98]"
                >
                  {project.linkLabel || "Buka proyek"}
                  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17L17 7M9 7h8v8" />
                  </svg>
                </a>
              )
            }
          </div>
        </aside>
      </div>
    </section>

    <section class="border-t border-slate-200 bg-slate-50 py-14 sm:py-20 dark:border-white/10 dark:bg-slate-900/40">
      <div class="mx-auto max-w-5xl px-6">
        <div class="mb-8 flex items-end justify-between gap-4">
          <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Proyek lainnya</h2>
          <a
            href="/#projects"
            class="text-sm font-medium text-indigo-600 hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300"
          >
            Lihat semua
          </a>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          {otherProjects.map((p) => <ProjectCard project={p} />)}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
