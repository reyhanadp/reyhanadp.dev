---
import SectionHeading from "./SectionHeading.astro";
import { getContent, toLang } from "../data";

const { education, certifications, ui } = getContent(toLang(Astro.currentLocale));

const card =
  "rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-white/[0.03] dark:shadow-none";
---

<section id="education" class="py-20 sm:py-24">
  <div class="mx-auto max-w-5xl px-6">
    <SectionHeading eyebrow={ui.education.eyebrow} title={ui.education.title} />

    <div class="grid gap-5 md:grid-cols-2">
      <div data-reveal class={card}>
        <h3 class="flex items-center gap-2 text-sm font-semibold text-slate-900 dark:text-white">
          <svg class="size-5 text-indigo-600 dark:text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 10L12 5 2 10l10 5 10-5Z" />
            <path d="M6 12v5c3 3 9 3 12 0v-5" />
          </svg>
          {ui.education.educationLabel}
        </h3>
        <ul class="mt-5 space-y-5">
          {
            education.map((edu) => (
              <li>
                <p class="font-semibold text-slate-900 dark:text-white">{edu.school}</p>
                <p class="mt-0.5 text-sm">{edu.degree}</p>
                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                  {edu.period}
                  {edu.detail && ` · ${edu.detail}`}
                </p>
              </li>
            ))
          }
        </ul>
      </div>

      <div data-reveal class={card}>
        <h3 class="flex items-center gap-2 text-sm font-semibold text-slate-900 dark:text-white">
          <svg class="size-5 text-indigo-600 dark:text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="9" r="6" />
            <path d="M8.5 14l-1.5 7 5-3 5 3-1.5-7" />
          </svg>
          {ui.education.certificationsLabel}
        </h3>
        <ul class="mt-5 divide-y divide-slate-100 dark:divide-white/5">
          {
            certifications.map((cert) => (
              <li class="flex items-baseline justify-between gap-4 py-3 first:pt-0 last:pb-0">
                <p class="text-sm font-medium text-slate-800 dark:text-slate-200">{cert.name}</p>
                <p class="shrink-0 text-xs text-slate-500 dark:text-slate-400">{cert.year}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
