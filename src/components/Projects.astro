---
import SectionHeading from "./SectionHeading.astro";
import ProjectCard from "./ProjectCard.astro";
import { getContent, toLang } from "../data";
import type { ProjectGroup } from "../data/types";

const { projects, ui } = getContent(toLang(Astro.currentLocale));

const groupOrder: ProjectGroup[] = ["software", "data"];
const groups = groupOrder
  .map((key) => ({
    key,
    label: ui.projects.groups[key],
    items: projects.filter((project) => project.group === key),
  }))
  .filter((group) => group.items.length > 0);
---

<section id="projects" class="bg-slate-50 py-20 sm:py-24 dark:bg-slate-900/40">
  <div class="mx-auto max-w-5xl px-6">
    <SectionHeading
      eyebrow={ui.projects.eyebrow}
      title={ui.projects.title}
      description={ui.projects.description}
    />

    <div class="space-y-16">
      {
        groups.map((group) => (
          <div id={`projects-${group.key}`} class="scroll-mt-24">
            <div class="mb-6 flex items-center gap-4">
              <h3 class="text-base font-bold text-slate-900 dark:text-white">{group.label}</h3>
              <span class="rounded-full bg-slate-200/70 px-2.5 py-0.5 text-xs font-semibold text-slate-600 dark:bg-white/10 dark:text-slate-300">
                {group.items.length} {ui.projects.countLabel}
              </span>
              <span aria-hidden="true" class="h-px flex-1 bg-slate-200 dark:bg-white/10" />
            </div>
            <div class="grid gap-4">
              {group.items.map((project) => (
                <div data-reveal>
                  <ProjectCard project={project} />
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
