---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="mb-10 max-w-2xl sm:mb-12">
  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-indigo-600 dark:text-indigo-400">
    {eyebrow}
  </p>
  <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
    {title}
  </h2>
  {description && <p class="mt-3 text-base leading-relaxed text-pretty">{description}</p>}
</div>
