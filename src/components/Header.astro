---
import { getRelativeLocaleUrl } from "astro:i18n";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";
import { getContent, toLang } from "../data";

const lang = toLang(Astro.currentLocale);
const { profile, ui } = getContent(lang);
const home = getRelativeLocaleUrl(lang, "/");

const navLinks = [
  { id: "about", href: `${home}#about`, label: ui.nav.about },
  { id: "experience", href: `${home}#experience`, label: ui.nav.experience },
  { id: "projects", href: `${home}#projects`, label: ui.nav.projects },
  { id: "education", href: `${home}#education`, label: ui.nav.education },
  { id: "contact", href: `${home}#contact`, label: ui.nav.contact },
];
---

<header
  class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/80 backdrop-blur-md dark:border-white/10 dark:bg-slate-950/80"
>
  <nav class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-3">
    <a href={home} class="flex items-center gap-2.5 text-sm font-semibold text-slate-900 dark:text-white">
      <img
        src="/profile/photo.jpg"
        alt=""
        width="32"
        height="32"
        class="size-8 shrink-0 rounded-full object-cover ring-1 ring-slate-200 dark:ring-white/10"
      />
      <span class="hidden sm:inline">{profile.name}</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            data-nav={link.id}
            class="rounded-full px-3.5 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 aria-[current=true]:bg-indigo-50 aria-[current=true]:text-indigo-700 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white dark:aria-[current=true]:bg-indigo-500/15 dark:aria-[current=true]:text-indigo-300"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <LanguageToggle />
      <ThemeToggle />
      <button
        id="menu-toggle"
        type="button"
        aria-label={ui.a11y.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid size-9 place-items-center rounded-full border border-slate-200 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 md:hidden dark:border-white/10 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" hidden class="border-t border-slate-200/70 md:hidden dark:border-white/10">
    <ul class="mx-auto flex max-w-5xl flex-col px-4 py-2">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            data-nav={link.id}
            class="block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-100 aria-[current=true]:bg-indigo-50 aria-[current=true]:text-indigo-700 dark:text-slate-200 dark:hover:bg-white/10 dark:aria-[current=true]:bg-indigo-500/15 dark:aria-[current=true]:text-indigo-300"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    if (!menu) return;
    menu.hidden = !menu.hidden;
    toggle.setAttribute("aria-expanded", String(!menu.hidden));
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.hidden = true;
      toggle?.setAttribute("aria-expanded", "false");
    });
  });

  // Scroll-spy: tandai link nav sesuai section yang sedang terlihat
  const navLinks = document.querySelectorAll<HTMLAnchorElement>("[data-nav]");
  const sections = Array.from(navLinks)
    .map((link) => document.getElementById(link.dataset.nav ?? ""))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length > 0) {
    const setActive = (id: string | null) => {
      navLinks.forEach((link) => {
        if (link.dataset.nav === id) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      });
    };

    const update = () => {
      const marker = window.innerHeight * 0.35;
      let current: string | null = null;
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= marker) current = section.id;
      }
      setActive(current);
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
  }
</script>
