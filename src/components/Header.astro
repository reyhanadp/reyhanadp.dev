---
import { getRelativeLocaleUrl } from "astro:i18n";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageToggle from "./LanguageToggle.astro";
import { getContent, toLang } from "../data";

const lang = toLang(Astro.currentLocale);
const { profile, ui } = getContent(lang);
const home = getRelativeLocaleUrl(lang, "/");

const navLinks = [
  { href: `${home}#about`, label: ui.nav.about },
  { href: `${home}#experience`, label: ui.nav.experience },
  { href: `${home}#projects`, label: ui.nav.projects },
  { href: `${home}#education`, label: ui.nav.education },
  { href: `${home}#contact`, label: ui.nav.contact },
];

const initial = profile.name.charAt(0);
---

<header
  class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/80 backdrop-blur-md dark:border-white/10 dark:bg-slate-950/80"
>
  <nav class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-3">
    <a href={home} class="flex items-center gap-2.5 text-sm font-semibold text-slate-900 dark:text-white">
      <span class="grid size-8 place-items-center rounded-lg bg-indigo-600 text-sm font-bold text-white">
        {initial}
      </span>
      <span class="hidden sm:inline">{profile.name}</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="rounded-full px-3.5 py-1.5 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <LanguageToggle />
      <ThemeToggle />
      <button
        id="menu-toggle"
        type="button"
        aria-label={ui.a11y.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid size-9 place-items-center rounded-full border border-slate-200 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 md:hidden dark:border-white/10 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" hidden class="border-t border-slate-200/70 md:hidden dark:border-white/10">
    <ul class="mx-auto flex max-w-5xl flex-col px-4 py-2">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 transition hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-white/10"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    if (!menu) return;
    menu.hidden = !menu.hidden;
    toggle.setAttribute("aria-expanded", String(!menu.hidden));
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.hidden = true;
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
