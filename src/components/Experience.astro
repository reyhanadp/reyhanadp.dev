---
import SectionHeading from "./SectionHeading.astro";
import { experience } from "../data/profile";
---

<section id="experience" class="py-20 sm:py-24">
  <div class="mx-auto max-w-5xl px-6">
    <SectionHeading eyebrow="Pengalaman" title="Perjalanan karier" />

    <ol class="relative ml-2 border-l border-slate-200 dark:border-white/10">
      {
        experience.map((job) => (
          <li class="relative pb-12 pl-8 last:pb-0">
            <span
              aria-hidden="true"
              class="absolute top-1.5 -left-[7px] size-3.5 rounded-full border-[3px] border-white bg-indigo-600 ring-1 ring-slate-200 dark:border-slate-950 dark:ring-white/10"
            />
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400">{job.period}</p>
            <h3 class="mt-1 text-xl font-bold text-slate-900 dark:text-white">{job.role}</h3>
            <p class="text-base font-medium text-indigo-600 dark:text-indigo-400">{job.company}</p>
            <p class="mt-3 max-w-2xl leading-relaxed text-pretty">{job.summary}</p>
            <ul class="mt-4 max-w-2xl space-y-2">
              {job.highlights.map((point) => (
                <li class="flex gap-3 text-sm leading-relaxed">
                  <svg class="mt-1 size-4 shrink-0 text-indigo-600 dark:text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12l5 5L20 7" />
                  </svg>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>
